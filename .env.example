# ===== LLM（阿里云百炼 DashScope，OpenAI 兼容模式；变量名沿用历史命名）=====
# ⚠️ 请手动把下面的 sk-xxx 替换为你的百炼 API Key
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxx
SILICONFLOW_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型：调度 Agent 用 qwen3.8-max（指令跟随更强），视觉模型保持 qwen3.7-plus
TEXT_MODEL=qwen3.8-max
# 提取流水线文本通道（Excel/PDF文本/DOC）专用模型：qwen3.7-plus；
# 调度 Agent 仍用上面的 TEXT_MODEL（qwen3.8-max），两者解耦互不影响。
EXTRACTION_TEXT_MODEL=qwen3.7-plus
# 提取通道默认关闭思考模式：提取是照抄任务无需思考，避免大 JSON 输出超时；
# 调度 Agent 的思考模式由全局 LLM_ENABLE_THINKING 控制，保持开启。
EXTRACTION_ENABLE_THINKING=0
LLM_ENABLE_THINKING=1
VISION_MODEL=qwen3.7-plus

# ===== 数据库路径 =====
# 必须写绝对路径：相对路径会随进程启动目录/项目副本漂移，曾因此连错空库
# Windows 示例：D:\yamato\app\data\master.db
MASTER_DB_PATH=D:\yamato\app\data\master.db
CHECKPOINT_DB_PATH=D:\yamato\app\data\checkpoints.db

# ===== 业务路径 =====
# 上游工厂文件夹根目录（Node2 路由 + 审核界面白名单 + validation 共用）
# Windows 示例：D:\yamato\96\工厂
UPSTREAM_ROOT=D:\yamato\96\工厂
# 下游装箱表默认路径（生产可按批次用请求体 downstream_file_path 覆盖）
DOWNSTREAM_FILE_PATH=D:\yamato\96\ContentsOfTheContainer.xlsx
# 输出目录（写回的 Excel 副本，绝不覆盖原件；相对路径 = 项目根下）
OUTPUT_DIR=app/output
# 工厂别名映射表（下游日文/英文名 -> 本地中文文件夹名；持久维护，不随批次变）
ALIAS_MAP_PATH=app/alias_map.json
# Ground Truth 主源/兜底源（validation 用；改后自动作废 GT 缓存重建）
GT_SOURCE=D:\yamato\96\SKU汇总.xlsx
GT_FALLBACK=D:\yamato\96\SKU汇总.xlsx

# ===== RAG 知识库（调度 Agent 检索）=====
# keyword = 硬编码 KB + 关键词匹配（默认，无需任何 key）
# pinecone = 向量检索（需填 PINECONE_API_KEY），失败自动回落 keyword
KB_BACKEND=keyword
# ⚠️ 请手动填入 Pinecone API Key 后把 KB_BACKEND 改为 pinecone
PINECONE_API_KEY=
PINECONE_INDEX=yamato-dispatcher
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Embedding 独立密钥：聊天模型走百炼 token-plan 代理（不支持 embeddings），
# 向量计算走硅基流动，与 SILICONFLOW_API_KEY 不共用
# ⚠️ 请手动填入硅基流动 API Key
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSIONS=1024
RAG_MIN_SCORE=0.5

# ===== 调度 Agent =====
# 引擎：react（create_react_agent）；回退改为 legacy
DISPATCHER_ENGINE=react

# ===== 提取引擎 =====
# 置 1 时强制使用 mock 提取数据（跳过真实 LLM，用于冒烟测试）
EXTRACTION_MOCK=0
# LibreOffice soffice.exe 完整路径（仅自定义安装目录/未加入 PATH 时需要；
# Windows 默认 C:\Program Files\LibreOffice\program\soffice.exe 可自动探测，无需设置）
# SOFFICE_PATH=
