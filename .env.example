# ===== LLM（阿里云百炼 DashScope，OpenAI 兼容模式；变量名沿用历史命名）=====
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxx
SILICONFLOW_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen3.7-plus
TEXT_MODEL=qwen3.7-plus
# 关闭思考模式可大幅提速（提取任务推荐 0）
LLM_ENABLE_THINKING=0

# ===== 数据库路径 =====
# 主数据（factories / factory_skus）
MASTER_DB_PATH=app/data/master.db
# LangGraph checkpoint（人机协同挂起/恢复的状态持久化）
CHECKPOINT_DB_PATH=app/data/checkpoints.db

# ===== 业务路径（生产三层路径策略，见 PROGRESS.md 第 7 节）=====
# 【层1·配置项】上游工厂单据根目录（每个子文件夹 = 一个工厂）。
# Node2 文件夹路由与审核界面路径白名单共用此根，保证"agent 能看的 =
# 界面能显示的"。启动时读一次，亦可在 POST /orders/process 请求体按批次覆盖。
UPSTREAM_ROOT=/Users/nz/Downloads/yamato/96/工厂
# 【层2·按批次传入】下游装箱单（买家标准装箱明细表，文件名带批次信息，
# 每个航次/截单批次都换）。此处仅为开发默认值；生产应在 POST /orders/process
# 请求体的 downstream_file_path 传入，Node1 解析后存入 state 供全链路使用。
DOWNSTREAM_FILE_PATH=/Users/nz/Downloads/yamato/96/ContentsOfTheContainer_202624_青島XD_20260708.xlsx
# 【层3·随事件给出】单文件路径不入配置：增量模式 process_file(session, path)
# 由调用方（目录 watcher/人工拖入/邮件脚本）递入；批量 extract_factory 仅用于
# 初始化/补录。
# 输出目录（写回的 Excel 副本，绝不覆盖原件）
OUTPUT_DIR=app/output
# 工厂别名映射表（下游日文/英文名 -> 本地中文文件夹名；持久维护，不随批次变）
ALIAS_MAP_PATH=app/alias_map.json

# ===== 提取引擎 =====
# 置 1 时强制使用 mock 提取数据（跳过真实 LLM，用于冒烟测试）
EXTRACTION_MOCK=0
